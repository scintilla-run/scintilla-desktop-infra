[Unit]
Description=Scintilla Desktop Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=SCINTILLA_DAEMON_LISTEN=127.0.0.1:8765
Environment=SCINTILLA_DAEMON_DATA_DIR=__RUNTIME_DIR__
Environment=SCINTILLA_DAEMON_FLAGS_CONFIG=__FLAGS_CONFIG__
Environment=SCINTILLA_DESKTOP_MANIFEST=__MANIFEST__
ExecStart=__BINARY__
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__RUNTIME_DIR__ __STATE_DIR__ __MANIFEST_DIR__

[Install]
WantedBy=default.target
