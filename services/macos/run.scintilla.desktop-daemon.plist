<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>run.scintilla.desktop-daemon</string>
  <key>ProgramArguments</key><array><string>__BINARY__</string></array>
  <key>EnvironmentVariables</key><dict>
    <key>SCINTILLA_DAEMON_LISTEN</key><string>127.0.0.1:8765</string>
    <key>SCINTILLA_DAEMON_DATA_DIR</key><string>__RUNTIME_DIR__</string>
    <key>SCINTILLA_DAEMON_FLAGS_CONFIG</key><string>__FLAGS_CONFIG__</string>
    <key>SCINTILLA_DESKTOP_MANIFEST</key><string>__MANIFEST__</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>StandardOutPath</key><string>__LOG_DIR__/daemon.log</string>
  <key>StandardErrorPath</key><string>__LOG_DIR__/daemon.err.log</string>
</dict></plist>
