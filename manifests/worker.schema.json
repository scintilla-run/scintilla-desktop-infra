{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/scintilla-run/scintilla-desktop-infra/manifests/worker.schema.json",
  "title": "Scintilla desktop worker spec",
  "type": "object",
  "additionalProperties": false,
  "required": ["worker_version", "id", "mode", "runtime", "artifact_sha256", "max_run_ms", "env_allowlist"],
  "properties": {
    "worker_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{0,127}$"},
    "mode": {"enum": ["host", "container"]},
    "runtime": {"enum": ["rust", "typescript", "python", "go"]},
    "artifact_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "max_run_ms": {"type": "integer", "minimum": 1, "maximum": 86400000},
    "env_allowlist": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$"}},
    "cpu_limit_millis": {"type": "integer", "minimum": 1},
    "memory_limit_mb": {"type": "integer", "minimum": 16}
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "host"}}},
      "then": {"required": ["argv"], "not": {"required": ["image_digest"]}}
    },
    {
      "if": {"properties": {"mode": {"const": "container"}}},
      "then": {"required": ["image_digest"], "not": {"required": ["argv"]}}
    }
  ]
}
