<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.scintilla.desktop-daemon</string>
<key>ProgramArguments</key><array><string>/Users/YOU/.local/bin/scintilla-desktop-daemon</string></array>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><true/>
<key>StandardOutPath</key><string>/Users/YOU/.scintilla/daemon/stdout.log</string>
<key>StandardErrorPath</key><string>/Users/YOU/.scintilla/daemon/stderr.log</string>
</dict></plist>
