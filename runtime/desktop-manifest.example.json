{
  "schema": "scintilla.desktop-runtime/v1",
  "runtime_kind": "scintilla-single-beam",
  "ingress": {
    "command": {
      "program": "__SCINTILLA_INGRESS_BIN__",
      "args": ["foreground"],
      "cwd": "__SCINTILLA_INGRESS_ROOT__",
      "env": {
        "SCINTILLA_LISTEN": "127.0.0.1:8091"
      }
    },
    "stop": {
      "command": {
        "program": "__SCINTILLA_INGRESS_BIN__",
        "args": ["stop"],
        "cwd": "__SCINTILLA_INGRESS_ROOT__"
      },
      "timeout_seconds": 15
    },
    "release_command": "__SCINTILLA_INGRESS_BIN__"
  },
  "workers": [],
  "tunnel": {
    "tunnel": "scintilla-local",
    "hostname": "dev.example.com",
    "target": "http://127.0.0.1:8091",
    "credentials_file": "__CLOUDFLARED_CREDENTIALS__",
    "create": false,
    "route_dns": false
  },
  "update": null,
  "preferences": {
    "keep_scintilla_alive_during_lock_screen": false
  },
  "control_plane": {
    "protocol": "scintilla.local-control/v1",
    "clients": [
      {"kind":"cli","capabilities":["status.read","runtime.reconcile","runtime.stop","worker.read","worker.control","tunnel.control","updates.apply","preferences.write"]},
      {"kind":"rust_desktop","capabilities":["status.read","runtime.reconcile","runtime.stop","worker.read","tunnel.control","preferences.write"]},
      {"kind":"flutter_desktop","capabilities":["status.read","runtime.reconcile","runtime.stop","worker.read","tunnel.control","preferences.write"]},
      {"kind":"flutter_mobile","capabilities":["status.read","mobile.task.execute"]},
      {"kind":"infra","capabilities":["runtime.reconcile","worker.control"]}
    ]
  }
}
